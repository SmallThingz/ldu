# Maintainer: ldu contributors <https://github.com/SmallThingz/ldu>
pkgname=ldu
pkgver=0.1.0
pkgrel=1
pkgdesc='Browse disk usage, preview files and queue deletions in your terminal'
arch=('x86_64' 'aarch64' 'armv7h' 'riscv64')
url='https://github.com/SmallThingz/ldu'
license=('MIT')
depends=('gcc-libs' 'glibc')
# Check the compiler release in prepare/build; rustup provides unversioned rust.
# Arch's rust package supplies Cargo and the standard-library license catalog.
makedepends=('rust' 'python')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        'generate-notices.py'
        'rust-1.99.0-notices.tar.gz')
sha256sums=('a074a8a806ba732458fdd59b7b55d96116b984597ed3f7e3fbc0dfeac5b15470'
            'b8f098e1daadb8445400d9e1519ac882b5a78bd44dd032e1f4b05929b147ee03'
            '82dc19f9a3494b9c6971aa3f31e2e1e8fdaacaa7d7e2f177aee7d612d253301c')

prepare() {
    cd "$pkgname-$pkgver"
    # Use Rust 1.99.0 from the distribution or an already installed rustup toolchain.
    export RUSTUP_TOOLCHAIN=1.99.0
    export RUSTUP_AUTO_INSTALL=0
    [[ $(rustc --version) == 'rustc 1.99.0 '* ]] || {
        error 'Rust 1.99.0 is required by the bundled runtime notice attribution'
        return 1
    }
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=1.99.0
    export RUSTUP_AUTO_INSTALL=0
    [[ $(rustc --version) == 'rustc 1.99.0 '* ]] || {
        error 'Rust 1.99.0 is required by the bundled runtime notice attribution'
        return 1
    }
    export CARGO_TARGET_DIR=target
    python "$srcdir/generate-notices.py" --source . --output THIRD-PARTY-NOTICES.txt \
        --rust-notices "$srcdir/rust-1.99.0-notices"
    cargo build --frozen --release --bin ldu
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 target/release/ldu "$pkgdir/usr/bin/ldu"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 THIRD-PARTY-NOTICES.txt "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.txt"
}
